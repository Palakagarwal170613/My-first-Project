        "# -----------------------------------------------------------------------------\n",
        "print(\"\\n\" + \"=\"*75)\n",
        "print(\"TASK 15: FIVE EVIDENCE-BASED OPERATIONAL RECOMMENDATIONS FOR HOTEL MANAGEMENT\")\n",
        "print(\"=\"*75)\n",
